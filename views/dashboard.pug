								div(class="col col-md-auto")
									p(class="card-text") Lon: 12.73920
						div(class="card-body")
							div(class="row row-cols-2 row-cols-md-4 g-2")
								div(class="col")
									div(class="card" data-bs-theme="light")
										div(class="card-body")
											div(class="row align-items-center")
												div(class="col")
													h3(class="card-title") Wetter
													p(class="card-text") 800
												div(class="col col-md-auto justify-self-right")
													img(class="text-primary" src="bootstrap/icons/sun.svg")
								div(class="col")
									div(class="card")
										div(class="card-body")
											div(class="row align-items-center")
												div(class="col")
													h3(class="card-title") Temperatur
