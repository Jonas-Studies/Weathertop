mixin station(input_name)
	div(class="card")
		div(class="card-header")
			div(class="row align-items-center")
				div(class="col col-md-auto")
					h4(class="card-title")= input_name
				div(class="col col-md-auto")
					p(class="card-text") Lat: 49.01285
				div(class="col col-md-auto")
					p(class="card-text") Lon: 12.73920
		div(class="card-body")
			div(class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-2")
				div(class="col")
					+station_data("Wetter","800","icons/sun.svg")
				div(class="col")
					+station_data("Temperatur","32,5 Grad","icons/thermometer-half.svg")
				div(class="col")
					+station_data("Wind","15 bft","icons/wind.svg")
				div(class="col")
					+station_data("Luftdruck","90 hpa","icons/sun.svg")
		div(class="card-footer color-border-black")
			div(class="row")
				div(class="col col-md-auto")
					a(href="station")
						img(src="icons/pencil-square.svg" alt="Details")
				div(class="col col-md-auto")
					a(href="#")
						img(src="icons/trash.svg" alt="Delete")

mixin station_data(input_headline, input_values, input_iconpath)
	div(class="card")
			div(class="card-body")
				div(class="row align-items-center")
					div(class="col")
						h5(class="card-title")= input_headline
						p(class="card-text")= input_values
					div(class="col col-md-auto justify-self-right")
						img(src=input_iconpath)
