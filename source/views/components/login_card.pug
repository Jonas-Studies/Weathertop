mixin login-card
	div(class="card")
		div(class="card-header")
			h4(class="card-title") Anmelden
		div(class="card-body d-grid gap-3")
			section(class="row")
				section(class="col")
					label(class="form-label") Benutzername
					input(class="form-control" id="login-user-input-name" type="text")
			section(class="row")
				section(class="col")
					label(class="form-label") Passwort
					input(class="form-control" id="login-user-input-password" type="password")
			section(class="row")
				section(class="col")
					button(class="btn btn-primary" onclick="login_user()") Anmelden
		script(src="js/login_card.js")
