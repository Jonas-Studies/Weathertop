mixin create_reading_form ()
	div(class="card")
		header(class="card-header")
			h5 Hinzufügen Messung
		section(class="card-body")
			section(class="row")
				section(class="col")
					label(class="form-label" for="weathercode") Wetter
					input(class="form-control" id="create-reading-input-weathercode" type="number")
				section(class="col")
					label(class="form-label" for="temperature") Temperatur
					input(class="form-control" id="create-reading-input-temperature" type="number")
				section(class="col")
					label(class="form-label" for="windspeed") Wind
					input(class="form-control" id="create-reading-input-windspeed" type="number")
				section(class="col")
					label(class="form-label" for="airpressure") Luftdruck
					input(class="form-control" id="create-reading-input-airpressure" type="number")
		footer(class="card-footer")
			button(onclick="create_reading()" id="create-reading-button" class="btn btn-primary") Speichern
	script(src="js/create_reading_form.js")
