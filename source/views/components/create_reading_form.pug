mixin create_reading_form (weathercodes, weatherstation_ID)
	div(class="card shadow-sm")
		form
			header(class="card-header")
				h5 Hinzufügen Messung
			section(class="card-body")
				section(class="row")
					section(class="col")
						label(class="form-label" for="create-reading-selected-weathercode") Wetter
						select(class="form-select" id="create-reading-selected-weathercode" required="required")
							each weathercode in weathercodes
								option(value=weathercode.key)= weathercode.name
					section(class="col")
						label(class="form-label" for="create-reading-input-temperature") Temperatur
						div(class="input-group")
							input(class="form-control" id="create-reading-input-temperature" type="number" step="0.000001" placeholder="0.00" required="required")
							div(class="input-group-text")= "°C"
					section(class="col")
						label(class="form-label" for="create-reading-input-windspeed") Windspeed
						div(class="input-group")
							input(class="form-control" id="create-reading-input-windspeed" type="number" step="0.000001" min="0" placeholder="0.00" required="required")
							div(class="input-group-text")= "km/h"
					section(class="col")
						label(class="form-label" for="create-reading-input-winddirection") Windrichtung
						div(class="input-group")
							input(class="form-control" id="create-reading-input-winddirection" type="number" step="0.000001" min="0" max="360" placeholder="0.00" required="required")
							div(class="input-group-text")= "°"
					section(class="col")
						label(class="form-label" for="create-reading-input-airpressure") Luftdruck
						div(class="input-group")
							input(class="form-control" id="create-reading-input-airpressure" type="number" step="0.000001" min="0" placeholder="0.00" required="required")
							div(class="input-group-text")= "hpa"
			footer(class="card-footer")
				div(class="row g-3")
					div(class="col col-md-auto")
						button(type="submit" id="create-reading-button" class="btn btn-primary") Speichern
					div(class="col col-md-auto")
						button(onclick="create_reading_automatic()" type="button" id="create-reading-button-auto" class="btn btn-secondary") Automatische Messung hinzufügen
	script(src="/js/create_reading_form.js" onload="init_create_reading_form()")
