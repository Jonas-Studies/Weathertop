mixin create_weatherstation_form (weatherstations)
	div(class="card")
		form
			header(class="card-header")
				h4(class="card-title") Hinzufügen Wetterstation
			section(class="card-body")
				section(class="row")
					section(class="col col-6 col-md-4")
						div
							label(class="form-label" for="create-weatherstation-input-name") Name
							input(class="form-control" id="create-weatherstation-input-name" tpye="text" required="required")
						div(class="mt-2")
							label(class="form-label" for="create-weatherstation-input-latitude" ) Latitude
							input(class="form-control" id="create-weatherstation-input-latitude" type="number" step="0.000001" min="-90" max="90" placeholder="0.000000" required="required")
						div(class="mt-2")
							label(class="form-label" for="create-weatherstation-input-latitude") Longitude
							input(class="form-control" id="create-weatherstation-input-longitude" type="number" step="0.000001" min="-180" max="180" placeholder="0.000000" required="required")
					section(class="col")
						div(id="map" style="height: 320px;")
			footer(class="card-footer")
				section(class="row")
					section(class="col")
						button(id="create-weatherstation-button" type="submit" class="btn btn-primary") Speichern
	script(src="/js/create_weatherstation_form.js" onload="init_create_weatherstation_form()")
