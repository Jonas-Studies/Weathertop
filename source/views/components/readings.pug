mixin readings
	div(class="card")
		div(class="card-header")
			div(class="card-title") Messungen
		div(class="card-body")
			table(class="table")
				thead
					tr
						th(scope="col") Wetter
						th(scope="col") Temperatur
						th(scope="col") Wind
						th(scope="col") Luftdruck
				tbody
					tr
						td 800
						td 32,5
						td 15
						td 90
