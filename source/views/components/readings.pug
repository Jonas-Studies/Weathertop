mixin readings (input_readings)
	div(class="card shadow-sm")
		div(class="card-header")
			h5(class="card-title")= "Messungen"
		div(class="card-body")
			div(class="table-responsive")
				table(class="table")
					thead
						tr
							th(scope="col")= "Erstellzeitpunkt"
							th(scope="col")= "Wetter"
							th(scope="col")= "Temperatur"
							th(scope="col")= "Windgeschwindigkeit"
							th(scope="col")= "Windrichtung"
							th(scope="col")= "Luftdruck"
							th(scope="col")
					tbody
						each reading in input_readings	
							tr
								td= reading.created_on_text
								td= reading.weathercode_text
								td= reading.temperature
								td= reading.windspeed
								td= reading.winddirection
								td= reading.airpressure
								td
									button(class="btn p-0" onclick="delete_reading_by_id('"+ reading.ID + "')" )
										svg(class="bi text-primary" width="20" height="20" fill="currentColor")
											use(xlink:href="/icons/bootstrap-icons.svg#trash")
	script(src="/js/delete_reading.js")
