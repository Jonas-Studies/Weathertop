mixin readings (input_readings)
	div(class="card")
		div(class="card-header")
			div(class="card-title") Messungen
		div(class="card-body")
			table(class="table")
				thead
					tr
						th(scope="col") Wetter
						th(scope="col") Temperatur
						th(scope="col") Wind
						th(scope="col") Luftdruck
						th(scope="col")
				tbody
					each reading in input_readings	
						tr
							td= reading.weathercode
							td= reading.temperature.value
							td= reading.windspeed.value
							td= reading.airpressure.value
							td
								a(href="http://localhost:3000/reading/delete_one_by_id?id="+reading.ID)
									svg(class="bi text-primary" width="20" height="20" fill="currentColor")
										use(xlink:href="icons/bootstrap-icons.svg#trash")
