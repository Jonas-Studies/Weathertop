extends layouts/main.pug

include components/navbar.pug
include components/create_weatherstation_form.pug
include components/weatherstation.pug

block title
	title= "WeatherTop - Dashboard"

block content
	header
		+navbar( [ { name: "Dashboard", url: "/dashboard" }, { name: "Logout", url: "/logout" } ] )
	section(class="container")
		section(class="mt-4")
			+ create_weatherstation_form()
		section
			if weatherstations.length
				each weatherstation in weatherstations 
					div(class="mt-4")
						+ weatherstation( weatherstation, false )
			
			else
				div(class="alert alert-info mt-4" role="alert")= "No Weatherstations defined"
