extends layouts/main.pug

include components/navbar.pug
include components/create_reading_form.pug
include components/station.pug
include components/readings.pug

block title
	title WeatherTop - Regensburg

block content
	header
		+navbar( [ { name: 'Dashboard', url: '/dashboard' }, { name: 'Logout', url: '/logout' } ] )
	section(class="container mt-4")
		div(class="row row-cols-1 g-4")
			div(class="col")
				+station( weatherstation, true )
			div(class="col")
				+create_reading_form(weathercodes)
			div(class="col")
				+readings( readings )
	div(id="weatherstation-ID" class="invisible")= weatherstation.data.ID
